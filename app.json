{
  "expo": {
    "name": "ravi",
    "slug": "react-native-ravi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "RAVI a besoin du micro pour enregistrer des clips audio.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.tharsan.vishnukumar.reactnativeravi"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.tharsan.vishnukumar.reactnativeravi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-av",
        {
          "microphonePermission": "RAVI a besoin du micro pour enregistrer des clips audio."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f7fc98e0-b8f7-41ab-99ff-bf0e1ad7e8da"
      }
    },
    "owner": "tharsan.vishnukumar"
  }
}
